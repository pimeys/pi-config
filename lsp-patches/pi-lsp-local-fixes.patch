+  /**
+   * Retries `ContentModified` failures: rust-analyzer answers requests that arrive while its
+   * workspace is still loading with `-32801 content modified`, and the LSP spec tells the client
+   * to retry. Without this every first rename/reference request in a fresh session fails.
+   */
   private async sendRequestWithBudget<TResult>(
     method: string,
+    parameters: unknown,
+    budgetMs: number,
+    operation: string,
+    signal?: AbortSignal,
+  ): Promise<TResult> {
+    const deadline = Date.now() + budgetMs;
+    for (;;) {
+      try {
+        return await this.sendRequestOnce<TResult>(method, parameters, budgetMs, operation, signal);
+      } catch (cause) {
+        if (!isContentModifiedError(cause) || Date.now() + 1_000 > deadline) throw cause;
+        await new Promise((resolve) => setTimeout(resolve, 500));
+      }
+    }
+  }
