+/** LSP `ContentModified`: the server's view of the file changed, retry per spec. */
+const CONTENT_MODIFIED_CODE = -32801;
+
+/** Walk an error's cause chain looking for a `ContentModified` JSON-RPC error. */
+function isContentModifiedError(error: unknown): boolean {
+  let current: unknown = error;
+  while (current !== null && typeof current === "object") {
+    if ((current as { code?: unknown }).code === CONTENT_MODIFIED_CODE) return true;
+    current = (current as { cause?: unknown }).cause;
+  }
+  return false;
+}
